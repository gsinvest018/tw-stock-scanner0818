# 複製成 .env，填入實際帳密後使用
# .env 已被 .gitignore，不會 commit 到版控

# 全站 Basic Auth 帳密（兩者皆空 = 停用驗證，僅限本機開發）
SCANNER_USER=admin
SCANNER_PASS=changeme

# Flask debug：1 開、0 關（正式部署一律設 0）
FLASK_DEBUG=0

# ===== 以下皆為選填，未設定時使用預設值 =====

# Flask 監聽位址與埠（預設 0.0.0.0:5000，可由內網/Tailscale 存取）
#HOST=0.0.0.0
#PORT=5000

# ngrok 對外通道（watchdog.py 使用）
# NGROK_EXE 未設定時從 PATH 尋找；找不到 ngrok 就跳過對外通道
# NGROK_DOMAIN 留空 = 使用 ngrok 隨機網址
#NGROK_EXE=C:\path\to\ngrok.exe
#NGROK_DOMAIN=your-domain.ngrok-free.dev

# 券商 PDF 報告目錄（未掛載時 /broker-reports 頁優雅降級）
#BROKER_REPORTS_DIR=P:\2026年報告

# regime-detector 外部專案位置（/regime 市場體溫功能；缺少時該頁降級）
#REGIME_DETECTOR_DIR=D:\claude\src\regime-detector

# 研究週報來源目錄（/weekly 頁；預設為專案上層的 src/）
#RESEARCH_SRC_DIR=D:\claude\src

# 產業研究報告目錄（/research 頁；預設為專案內的 research/，可指向獨立的報告 repo）
#RESEARCH_DIR=D:\code\tw-stock-research

# 群益個股期報價本機服務（config.py）
#CAPITAL_QUOTE_URL=http://127.0.0.1:8891

# 非交易時段強制跑盤中爆量掃描（測試用）：1 開
#VOLUME_ALERT_FORCE_INTRADAY=0
